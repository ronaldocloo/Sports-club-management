# Copy to ../.env (which git ignores) and fill in. Never commit the real file.

# Database. Use long random values, for example: openssl rand -base64 24
DB_ROOT_PASSWORD=
DB_PASSWORD=
DB_NAME=sports_club
DB_USER=sportsapp

# Where the site is served on this machine.
WEB_PORT=8088

# true when the site is served over HTTPS (always, in production). Set false only to try it over plain http://localhost.
COOKIE_SECURE=true

# First platform administrator, created on first start if none exists. 8+ characters with a letter and a number.
# Fill the password in for the first start, then clear it.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=

# Demo data for investor demos: set DEMO_SEED=true for one start. Leave DEMO_PASSWORD empty to have a random
# one printed in the backend log (docker compose logs backend | grep Password).
DEMO_SEED=false
DEMO_PASSWORD=
